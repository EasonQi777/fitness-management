# 模拟服务的异常场景（默认全部关闭）。复制为 .env.local 后取消注释，重启 npm run dev 生效。
# 计数类表示“页面加载后接下来 N 次请求失败”，用完自动恢复；刷新页面重新计数。

# 订单列表查询返回 500（验证失败提示与重试）
# VITE_MOCK_FAIL_QUERY=1

# 新建 / 续卡 / 撤单返回 500，不修改任何数据（验证失败保留输入、可重试）
# VITE_MOCK_FAIL_WRITE=1

# 受保护请求返回 401（验证登录失效只提示一次并退出）
# VITE_MOCK_UNAUTHORIZED=1

# 会员姓名包含关键词的查询额外等待毫秒数，格式 关键词:毫秒（验证“先慢后快”只显示最后一次查询）
# VITE_MOCK_SLOW_QUERY=袁:3000

# 订单数据集：bulk 为批量测试数据集（33 笔，已到期 15 笔、可撤单 13 笔，均超过一页），用于演示跨页批量操作；默认 36 笔演示数据
# VITE_MOCK_DATASET=bulk
